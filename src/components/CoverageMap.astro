---
import 'leaflet/dist/leaflet.css';
import { cities, mapConfig, cityCount } from '../data/cities';

interface Props {
  height?: string;
  class?: string;
}

const { height = '540px', class: className } = Astro.props;
const id = 'coverage-map';
---

<div class:list={['map-shell', className]} style={`--map-height:${height}`}>
  <div
    id={id}
    class="map"
    role="application"
    aria-label={`Mapa interactivo con los ${cityCount} puntos operativos de SETI Technology en Perú`}
  >
  </div>

  <div class="map-legend" aria-hidden="true">
    <span class="map-legend__item">
      <span class="map-legend__pin map-legend__pin--hq"></span>
      Sede principal
    </span>
    <span class="map-legend__item">
      <span class="map-legend__pin"></span>
      Punto operativo
    </span>
  </div>

  <noscript>
    <div class="map-noscript">
      <p>
        Activa JavaScript para ver el mapa interactivo. Mientras tanto, estas son nuestras
        ciudades con cobertura:
      </p>
      <ul>
        {cities.map((city) => <li>{city.name} — {city.region}</li>)}
      </ul>
    </div>
  </noscript>
</div>

<script>
  import L from 'leaflet';
  import { cities, mapConfig } from '../data/cities';

  const init = () => {
    const el = document.getElementById('coverage-map');
    if (!el || el.dataset.ready === 'true') return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const map = L.map(el, {
      center: mapConfig.center,
      zoom: mapConfig.zoom,
      minZoom: mapConfig.minZoom,
      maxZoom: mapConfig.maxZoom,
      zoomControl: false,
      scrollWheelZoom: false,
      attributionControl: true,
    });

    L.control.zoom({ position: 'bottomright' }).addTo(map);
    L.control
      .attribution({ position: 'bottomleft', prefix: false })
      .addAttribution(mapConfig.tiles.attribution)
      .addTo(map);

    L.tileLayer(mapConfig.tiles.url, {
      maxZoom: mapConfig.tiles.maxZoom,
      detectRetina: false,
    }).addTo(map);

    // El zoom con rueda se activa al hacer clic en el mapa (evita secuestrar el scroll)
    map.on('click', () => map.scrollWheelZoom.enable());
    map.on('mouseout', () => map.scrollWheelZoom.disable());

    const escape = (value: string) =>
      value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    const markers = new Map<string, L.Marker>();
    const hq = cities.find((city) => city.role === 'hq');

    // Trazos desde la sede principal a cada punto operativo
    if (hq) {
      cities
        .filter((city) => city.id !== hq.id)
        .forEach((city) => {
          L.polyline([hq.coords, city.coords], {
            color: '#29e2f9',
            weight: 1,
            opacity: 0.22,
            dashArray: '4 10',
            interactive: false,
          }).addTo(map);
        });
    }

    const popupHtml = (city: (typeof cities)[number]) => `
      <div class="map-popup">
        <p class="map-popup__eyebrow">${city.role === 'hq' ? 'Sede principal' : 'Punto operativo'}</p>
        <h3 class="map-popup__title">${escape(city.name)}</h3>
        <p class="map-popup__region">${escape(city.region)} · Perú</p>
        <p class="map-popup__text">${escape(city.summary)}</p>
        <p class="map-popup__meta">${city.services.length} líneas de servicio disponibles</p>
        <a class="map-popup__link" href="/contacto/">Coordinar visita →</a>
      </div>
    `;

    cities.forEach((city) => {
      const icon = L.divIcon({
        className: 'map-pin',
        html: `<span class="map-pin__pulse"></span><span class="map-pin__core${city.role === 'hq' ? ' map-pin__core--hq' : ''}"></span>`,
        iconSize: [26, 26],
        iconAnchor: [13, 13],
        popupAnchor: [0, -14],
      });

      const marker = L.marker(city.coords, {
        icon,
        title: `${city.name} — ${city.region}`,
        keyboard: true,
        riseOnHover: true,
      })
        .addTo(map)
        .bindPopup(popupHtml(city), {
          maxWidth: 280,
          minWidth: 232,
          closeButton: true,
          autoPan: true,
          autoPanPaddingTopLeft: L.point(24, 90),
          autoPanPaddingBottomRight: L.point(24, 40),
        });

      markers.set(city.id, marker);
    });

    // Encuadre automático con todos los puntos operativos
    const bounds = L.latLngBounds(cities.map((city) => city.coords));
    map.fitBounds(bounds, { padding: mapConfig.padding, maxZoom: 8 });

    // Sincroniza las tarjetas/listas externas con el mapa
    const targets = document.querySelectorAll<HTMLElement>('[data-city-target]');
    const focusCity = (id: string, zoom = 9) => {
      const city = cities.find((item) => item.id === id);
      const marker = markers.get(id);
      if (!city || !marker) return;

      // Coloca el marcador un poco por debajo del centro para dejar sitio al popup
      const point = map.project(city.coords, zoom).subtract(L.point(0, 70));
      const target = map.unproject(point, zoom);

      if (reduceMotion) map.setView(target, zoom);
      else map.flyTo(target, zoom, { duration: 0.9 });

      marker.openPopup();

      targets.forEach((target) => {
        const active = target.dataset.cityTarget === id;
        target.classList.toggle('is-active', active);
        if (active) target.setAttribute('aria-current', 'true');
        else target.removeAttribute('aria-current');
      });
    };

    targets.forEach((target) => {
      target.addEventListener('click', (event) => {
        event.preventDefault();
        const id = target.dataset.cityTarget;
        if (id) focusCity(id);
      });
      target.addEventListener('mouseenter', () => {
        const id = target.dataset.cityTarget;
        const marker = id ? markers.get(id) : undefined;
        marker?.getElement()?.classList.add('is-hovered');
      });
      target.addEventListener('mouseleave', () => {
        const id = target.dataset.cityTarget;
        const marker = id ? markers.get(id) : undefined;
        marker?.getElement()?.classList.remove('is-hovered');
      });
    });

    // Abre el primer punto al cargar si el hash lo pide (ej. /cobertura/#lima)
    const hash = window.location.hash.replace('#', '');
    if (hash && markers.has(hash)) {
      window.setTimeout(() => focusCity(hash), 350);
    }

    window.addEventListener('resize', () => map.invalidateSize(), { passive: true });
    el.dataset.ready = 'true';
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }

  // Compatibilidad con el View Transitions / navegación de Astro
  document.addEventListener('astro:page-load', init);
</script>

<style is:global>
  .map-shell {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(41, 226, 249, 0.22);
    background: #061a2b;
    box-shadow:
      0 40px 80px -50px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(255, 255, 255, 0.03) inset;
  }

  .map {
    height: var(--map-height, 540px);
    width: 100%;
    background: #061a2b;
    z-index: 0;
  }

  .map .leaflet-tile-pane {
    /* OpenStreetMap claro → duotono azul profundo de la marca */
    filter: grayscale(1) invert(1) sepia(0.5) hue-rotate(160deg) saturate(2.6) brightness(0.85)
      contrast(1.05);
  }

  /* ---------- Pines ---------- */
  .map-pin {
    background: none;
    border: 0;
  }

  .map-pin__core {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: var(--teal-400);
    border: 2px solid #04141f;
    box-shadow:
      0 0 0 2px rgba(61, 187, 200, 0.5),
      0 0 18px 2px rgba(61, 187, 200, 0.65);
    transition: transform 160ms var(--ease-out), background 160ms var(--ease-out);
  }

  .map-pin__core--hq {
    width: 15px;
    height: 15px;
    margin: -7.5px 0 0 -7.5px;
    background: var(--cyan-300);
    box-shadow:
      0 0 0 3px rgba(41, 226, 249, 0.45),
      0 0 26px 4px rgba(41, 226, 249, 0.8);
  }

  .map-pin__pulse {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 16px;
    height: 16px;
    margin: -8px 0 0 -8px;
    border-radius: 50%;
    background: rgba(41, 226, 249, 0.5);
    animation: mapPulse 2.6s var(--ease-out) infinite;
  }

  .map-pin.is-hovered .map-pin__core,
  .map-pin:hover .map-pin__core {
    transform: scale(1.45);
    background: #fff;
  }

  @keyframes mapPulse {
    0% {
      transform: scale(0.6);
      opacity: 0.65;
    }
    80%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  /* ---------- Popups ---------- */
  .leaflet-popup-content-wrapper {
    background: rgba(7, 27, 45, 0.97);
    color: #fff;
    border: 1px solid rgba(41, 226, 249, 0.32);
    border-radius: var(--radius-md);
    box-shadow: 0 24px 50px -24px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(8px);
  }

  .leaflet-popup-content {
    margin: 0;
    width: auto !important;
  }

  .leaflet-popup-tip {
    background: rgba(7, 27, 45, 0.97);
    border: 1px solid rgba(41, 226, 249, 0.32);
  }

  .leaflet-container a.leaflet-popup-close-button {
    color: rgba(255, 255, 255, 0.55);
    width: 28px;
    height: 28px;
    top: 4px;
    right: 4px;
    font-size: 18px;
  }

  .leaflet-container a.leaflet-popup-close-button:hover {
    color: #fff;
  }

  .map-popup {
    width: 232px;
    padding: 1rem 1.1rem 1.15rem;
  }

  .map-popup__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cyan-300);
  }

  .map-popup__title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    color: #fff;
    margin-top: 0.2rem;
  }

  .map-popup__region {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 0.15rem;
  }

  .map-popup__text {
    font-size: 0.78rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
    margin-top: 0.6rem;
  }

  .map-popup__meta {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--teal-400);
    margin-top: 0.6rem;
  }

  .map-popup__link {
    display: inline-block;
    margin-top: 0.7rem;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--cyan-300);
    border-bottom: 1px solid rgba(41, 226, 249, 0.4);
  }

  /* ---------- Controles ---------- */
  .leaflet-control-zoom {
    border: 1px solid rgba(255, 255, 255, 0.16) !important;
    border-radius: var(--radius-sm) !important;
    overflow: hidden;
    box-shadow: 0 12px 24px -14px rgba(0, 0, 0, 0.9) !important;
  }

  .leaflet-control-zoom a {
    background: rgba(7, 27, 45, 0.92) !important;
    color: #d9f2fa !important;
    border-bottom-color: rgba(255, 255, 255, 0.1) !important;
    width: 32px !important;
    height: 32px !important;
    line-height: 30px !important;
  }

  .leaflet-control-zoom a:hover {
    background: rgba(41, 226, 249, 0.18) !important;
    color: #fff !important;
  }

  .leaflet-control-attribution {
    background: rgba(4, 20, 31, 0.72) !important;
    color: rgba(255, 255, 255, 0.45) !important;
    font-size: 10px !important;
    padding: 2px 8px !important;
    border-radius: 6px 0 0 0;
  }

  .leaflet-control-attribution a {
    color: rgba(255, 255, 255, 0.65) !important;
  }

  .leaflet-container {
    font-family: var(--font-body);
  }

  .leaflet-container:focus-visible {
    outline: 2px solid var(--cyan-300);
    outline-offset: -2px;
  }

  /* ---------- Elementos propios ---------- */
  .map-legend {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 500;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding: 0.55rem 0.85rem;
    background: rgba(4, 20, 31, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(10px);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.7);
  }

  .map-legend__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .map-legend__pin {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal-400);
    box-shadow: 0 0 8px rgba(61, 187, 200, 0.8);
  }

  .map-legend__pin--hq {
    background: var(--cyan-300);
    width: 10px;
    height: 10px;
    box-shadow: 0 0 10px rgba(41, 226, 249, 0.9);
  }

  .map-noscript {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 0.75rem;
    padding: 2rem;
    background: rgba(4, 20, 31, 0.96);
    font-size: 0.85rem;
    color: var(--on-dark-muted);
    text-align: center;
  }

  .map-noscript ul {
    display: grid;
    gap: 0.25rem;
    justify-items: center;
  }

  @media (max-width: 640px) {
    .map-legend {
      top: 0.6rem;
      left: 0.6rem;
      font-size: 0.6rem;
      padding: 0.45rem 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-pin__pulse {
      display: none;
    }
  }
</style>
