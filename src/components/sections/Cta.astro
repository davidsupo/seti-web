---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { site, whatsappLink } from '../../data/site';
import { withBase } from '../../lib/base';
---

<Section tone="dark" class="cta">
  <div class="cta__bg" aria-hidden="true"></div>
  <div class="container cta__inner">
    <div class="cta__content" data-reveal>
      <p class="eyebrow">Hablemos</p>
      <h2 class="cta__title">
        ¿Listo para proteger tu <span>operación</span>?
      </h2>
      <p class="cta__text">
        Cuéntanos qué necesitas proteger. Coordinamos una visita técnica, levantamos el
        riesgo y te entregamos una propuesta clara, sin sobredimensionar el proyecto.
      </p>
      <div class="cta__actions">
        <Button href="/contacto/" size="lg">Solicitar visita técnica</Button>
        <Button href={whatsappLink()} external variant="secondary" size="lg" icon="whatsapp">
          Escribir por WhatsApp
        </Button>
      </div>
    </div>

    <ul class="cta__contacts" data-reveal style="--reveal-delay:120ms">
      <li>
        <a href={site.phone.href}>
          <span class="cta__icon"><Icon name="phone" size={18} /></span>
          <span>
            <small>Llámanos</small>
            <strong>{site.phone.label}</strong>
          </span>
        </a>
      </li>
      <li>
        <a href={site.email.href}>
          <span class="cta__icon"><Icon name="mail" size={18} /></span>
          <span>
            <small>Escríbenos</small>
            <strong class="cta__email">{site.email.label.toLowerCase()}</strong>
          </span>
        </a>
      </li>
      <li>
        <a href={withBase('/cobertura/')}>
          <span class="cta__icon"><Icon name="map-pin" size={18} /></span>
          <span>
            <small>Visítanos</small>
            <strong>{site.headquarters.label}</strong>
          </span>
        </a>
      </li>
    </ul>
  </div>
</Section>

<style>
  .cta {
    overflow: hidden;
    background:
      radial-gradient(80% 120% at 12% 0%, rgba(41, 226, 249, 0.16) 0%, transparent 55%),
      radial-gradient(70% 100% at 100% 100%, rgba(61, 187, 200, 0.14) 0%, transparent 60%),
      linear-gradient(140deg, #0b2748 0%, #04141f 100%);
  }

  .cta__bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.09) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
    opacity: 0.5;
  }

  .cta__inner {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .cta__content {
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
  }

  .cta__title {
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    line-height: 0.95;
    text-transform: uppercase;
    color: #fff;
  }

  .cta__title span {
    color: var(--cyan-300);
  }

  .cta__text {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--on-dark-muted);
    max-width: 46ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .cta__contacts {
    display: grid;
    gap: 0.5rem;
  }

  .cta__contacts a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.03);
    transition:
      background var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .cta__contacts a:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(41, 226, 249, 0.4);
    transform: translateX(3px);
  }

  .cta__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(41, 226, 249, 0.12);
    color: var(--cyan-300);
  }

  .cta__contacts small {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .cta__contacts strong {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
    line-height: 1.4;
  }

  .cta__email {
    word-break: break-word;
  }

  @media (min-width: 900px) {
    .cta__inner {
      grid-template-columns: 1.25fr 0.75fr;
    }
  }
</style>
