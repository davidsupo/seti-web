---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { processSteps } from '../../data/process';
---

<Section id="proceso" tone="dark">
  <div class="container">
    <div class="proc__head">
      <SectionHeading
        eyebrow="Cómo trabajamos"
        title="Del levantamiento a la operación"
        highlight="operación"
        tone="dark"
        description="Un método de cuatro etapas que termina cuando el sistema está probado, documentado y en operación."
      />
      <Button href="/contacto/" variant="secondary" icon="arrow-right">Agendar visita técnica</Button>
    </div>

    <ol class="steps">
      {
        processSteps.map((step, index) => (
          <li class="step" data-reveal style={`--reveal-delay:${index * 100}ms`}>
            <div class="step__top">
              <span class="step__node">
                <Icon name={step.icon as any} size={18} />
              </span>
              <span class="step__num">{step.order}</span>
            </div>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__summary">{step.summary}</p>
            <ul class="step__details">
              {step.details.map((detail) => (
                <li>
                  <Icon name="check" size={12} stroke={2.6} />
                  {detail}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<style>
  .proc__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .steps {
    position: relative;
    display: grid;
    gap: 2.25rem;
    counter-reset: step;
  }

  .steps::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 12px;
    bottom: 12px;
    width: 1px;
    background: linear-gradient(
      180deg,
      rgba(41, 226, 249, 0.5),
      rgba(41, 226, 249, 0.12) 60%,
      transparent
    );
  }

  .step {
    position: relative;
    display: grid;
    gap: 0.55rem;
    padding-left: 3.5rem;
  }

  .step__top {
    display: contents;
  }

  .step__node {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(41, 226, 249, 0.1);
    border: 1px solid rgba(41, 226, 249, 0.4);
    color: var(--cyan-300);
    backdrop-filter: blur(4px);
    z-index: 1;
  }

  .step__num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--teal-400);
  }

  .step__title {
    font-size: var(--step-1);
    text-transform: uppercase;
    letter-spacing: 0.015em;
    line-height: 1.1;
    color: #fff;
    max-width: 22ch;
  }

  .step__summary {
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--on-dark-muted);
    max-width: 34ch;
  }

  .step__details {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.35rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .step__details li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .step__details svg {
    flex: none;
    margin-top: 0.3rem;
    color: var(--teal-400);
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.75rem;
    }

    .steps::before {
      left: 0;
      right: 0;
      top: 21px;
      bottom: auto;
      width: 100%;
      height: 1px;
      background: linear-gradient(
        90deg,
        rgba(41, 226, 249, 0.55),
        rgba(41, 226, 249, 0.2) 45%,
        rgba(41, 226, 249, 0.05)
      );
    }

    .step {
      padding-left: 0;
      padding-top: 3.75rem;
    }

    .step__node {
      width: 42px;
      height: 42px;
    }

    .step__num {
      display: block;
      margin-bottom: 0.15rem;
    }
  }
</style>
