---
const items = [
  'Detección de intrusión',
  'Detección de incendio',
  'Videovigilancia',
  'Control de acceso',
  'Conectividad y redes',
  'Analítica con IA',
  'NFPA 72 · NFPA 70',
  'Monitoreo 24/7',
  'Cableado estructurado',
  'Fibra óptica',
];
const loop = [...items, ...items];
---

<div class="ticker" aria-label="Capacidades técnicas de SETI Technology">
  <div class="ticker__track">
    {
      loop.map((item, index) => (
        <span class="ticker__item" aria-hidden={index >= items.length ? 'true' : undefined}>
          {item}
          <span class="ticker__sep" aria-hidden="true"></span>
        </span>
      ))
    }
  </div>
</div>

<style>
  .ticker {
    overflow: hidden;
    background: #04141f;
    border-block: 1px solid rgba(255, 255, 255, 0.07);
    padding-block: 0.9rem;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker 44s linear infinite;
  }

  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }

  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 1.6rem;
    padding-inline: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
    white-space: nowrap;
  }

  .ticker__sep {
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: var(--teal-400);
    transform: rotate(45deg);
    opacity: 0.7;
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      justify-content: center;
      row-gap: 0.5rem;
    }
  }
</style>
