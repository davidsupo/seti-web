---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { stats } from '../../data/site';
import { withBase } from '../../lib/base';
---

<section class="hero" id="inicio">
  <div class="hero__bg" aria-hidden="true">
    <img src={withBase('/images/circuito-fondo.webp')} alt="" class="hero__bg-img" width="1438" height="560" />
    <div class="hero__mesh"></div>
    <div class="hero__orb hero__orb--a"></div>
    <div class="hero__orb hero__orb--b"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__badge">
        <span class="hero__dot" aria-hidden="true"></span>
        Seguridad electrónica · Projects &amp; IA
      </p>

      <h1 class="hero__title">
        <span class="hero__line">Seguridad</span>
        <span class="hero__line hero__line--outline">Electrónica</span>
      </h1>

      <p class="hero__kicker">Projects &amp; Inteligencia Artificial</p>

      <p class="hero__lead">
        Diseñamos, implementamos y mantenemos soluciones integrales que protegen personas,
        bienes y operaciones: desde la ingeniería del proyecto hasta el soporte post-venta.
      </p>

      <div class="hero__actions">
        <Button href="/contacto/" size="lg">Cotiza tu proyecto</Button>
        <Button href="/servicios/" variant="secondary" size="lg" icon="arrow-right">
          Ver servicios
        </Button>
      </div>

      <ul class="hero__points">
        <li><Icon name="check" size={14} stroke={2.4} /> Ingeniería propia</li>
        <li><Icon name="check" size={14} stroke={2.4} /> Integración de sistemas</li>
        <li><Icon name="check" size={14} stroke={2.4} /> Cobertura nacional</li>
      </ul>
    </div>

    <div class="hero__visual">
      <div class="hero__ring" aria-hidden="true"></div>
      <figure class="hero__figure">
        <img
          src={withBase('/images/ia-projects.webp')}
          alt="Seguridad electrónica potenciada con inteligencia artificial"
          width="1400"
          height="933"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>
          <Icon name="sparkles" size={14} />
          Analítica de video con IA
        </figcaption>
      </figure>

      <div class="hero__chip hero__chip--tl">
        <span class="hero__chip-icon"><Icon name="camera" size={18} /></span>
        <span class="hero__chip-text">
          <strong>Videovigilancia</strong>
          <small>Monitoreo 24/7</small>
        </span>
      </div>

      <div class="hero__chip hero__chip--br">
        <span class="hero__chip-icon"><Icon name="shield-check" size={18} /></span>
        <span class="hero__chip-text">
          <strong>NFPA 72 · 70</strong>
          <small>Normativa aplicada</small>
        </span>
      </div>
    </div>
  </div>

  <div class="container">
    <ul class="hero__stats">
      {
        stats.map((stat) => (
          <li>
            <span class="hero__stat-value">{stat.value}</span>
            <span class="hero__stat-label">{stat.label}</span>
            <span class="hero__stat-detail">{stat.detail}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(165deg, #082239 0%, #0b2748 45%, #04141f 100%);
    color: #fff;
    padding-top: clamp(3.5rem, 7vw, 6rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* ---------- Fondo ---------- */
  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__bg-img {
    position: absolute;
    right: -5%;
    bottom: -12%;
    width: min(1100px, 85%);
    opacity: 0.2;
    mix-blend-mode: screen;
    filter: saturate(1.4) brightness(1.2);
    mask-image: radial-gradient(ellipse 60% 55% at 55% 55%, #000 15%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 55% 55%, #000 15%, transparent 72%);
  }

  .hero__mesh {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(41, 226, 249, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(41, 226, 249, 0.06) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 0%, transparent 75%);
  }

  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
  }

  .hero__orb--a {
    width: 520px;
    height: 520px;
    top: -180px;
    right: 8%;
    background: rgba(41, 226, 249, 0.16);
  }

  .hero__orb--b {
    width: 380px;
    height: 380px;
    bottom: -160px;
    left: -60px;
    background: rgba(61, 187, 200, 0.12);
  }

  /* ---------- Layout ---------- */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__content {
    display: grid;
    gap: 1.35rem;
    max-width: 40rem;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cyan-300);
  }

  .hero__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan-300);
    box-shadow: 0 0 0 4px rgba(41, 226, 249, 0.14);
    animation: heroPulse 2.6s var(--ease-in-out) infinite;
  }

  @keyframes heroPulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(0.7);
      opacity: 0.6;
    }
  }

  .hero__title {
    display: grid;
    font-family: var(--font-display);
    font-size: clamp(2.9rem, 8.2vw, 5.6rem);
    line-height: 0.86;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    color: #fff;
  }

  .hero__line--outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--cyan-300);
    text-shadow: 0 0 42px rgba(41, 226, 249, 0.25);
  }

  @supports not (-webkit-text-stroke: 1px black) {
    .hero__line--outline {
      color: var(--cyan-300);
    }
  }

  .hero__kicker {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.6vw, 1.2rem);
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
    margin-top: -0.35rem;
  }

  @media (max-width: 480px) {
    .hero__kicker {
      font-size: 0.76rem;
      letter-spacing: 0.16em;
    }
  }

  .hero__lead {
    font-size: var(--step-1);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.72);
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.4rem;
    margin-top: 0.4rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero__points li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero__points svg {
    color: var(--teal-400);
  }

  /* ---------- Visual ---------- */
  .hero__visual {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 520px;
  }

  .hero__figure {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(41, 226, 249, 0.28);
    box-shadow:
      0 40px 90px -40px rgba(0, 0, 0, 0.9),
      0 0 60px -30px rgba(41, 226, 249, 0.5);
    aspect-ratio: 4 / 3.4;
  }

  .hero__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.1) contrast(1.05);
  }

  .hero__figure::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(200deg, transparent 30%, rgba(4, 20, 31, 0.85) 100%);
  }

  .hero__figure figcaption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan-300);
    background: rgba(4, 20, 31, 0.7);
    border: 1px solid rgba(41, 226, 249, 0.3);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(6px);
  }

  .hero__ring {
    position: absolute;
    inset: -18px;
    border: 1px dashed rgba(41, 226, 249, 0.18);
    border-radius: calc(var(--radius-lg) + 18px);
    pointer-events: none;
  }

  .hero__chip {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.9rem;
    background: rgba(8, 34, 57, 0.86);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-md);
    backdrop-filter: blur(12px);
    box-shadow: 0 20px 40px -24px rgba(0, 0, 0, 0.9);
    animation: float 7s var(--ease-in-out) infinite;
  }

  .hero__chip--tl {
    top: 1.1rem;
    left: -0.75rem;
  }

  .hero__chip--br {
    bottom: -1.1rem;
    right: -0.5rem;
    animation-delay: -3.5s;
  }

  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -8px;
    }
  }

  .hero__chip-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgba(41, 226, 249, 0.14);
    color: var(--cyan-300);
  }

  .hero__chip-text {
    display: grid;
  }

  .hero__chip-text strong {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #fff;
  }

  .hero__chip-text small {
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--on-dark-muted);
  }

  /* ---------- Stats ---------- */
  .hero__stats {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero__stats li {
    display: grid;
    gap: 0.1rem;
  }

  .hero__stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 700;
    line-height: 1;
    color: var(--cyan-300);
  }

  .hero__stat-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #fff;
  }

  .hero__stat-detail {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.45);
  }

  @media (max-width: 420px) {
    .hero__chip--tl {
      left: 0.25rem;
    }

    .hero__chip--br {
      right: 0;
      bottom: -1.4rem;
    }
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }

    .hero__stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .hero__stats li + li {
      border-left: 1px solid rgba(255, 255, 255, 0.08);
      padding-left: 1.5rem;
    }
  }
</style>
