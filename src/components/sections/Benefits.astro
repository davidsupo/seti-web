---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { benefits } from '../../data/benefits';
---

<Section id="beneficios">
  <div class="container">
    <div class="ben__head">
      <SectionHeading
        eyebrow="Beneficios clave"
        title="Por qué trabajar con SETI"
        highlight="SETI"
        description="No vendemos equipos: entregamos sistemas que funcionan, se mantienen y escalan con la operación."
      />
    </div>

    <ul class="ben__grid">
      {
        benefits.map((benefit, index) => (
          <li class="ben" data-reveal style={`--reveal-delay:${index * 90}ms`}>
            <span class="ben__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="ben__icon">
              <Icon name={benefit.icon as any} size={24} />
            </span>
            <h3 class="ben__title">{benefit.title}</h3>
            <p class="ben__desc">{benefit.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  .ben__head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .ben__grid {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .ben {
    position: relative;
    display: grid;
    gap: 0.65rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--surface-0);
    transition: background var(--dur) var(--ease-out);
  }

  .ben:hover {
    background: var(--surface-1);
  }

  .ben__index {
    position: absolute;
    top: 1.1rem;
    right: 1.25rem;
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1;
    color: var(--surface-2);
    transition: color var(--dur) var(--ease-out);
  }

  .ben:hover .ben__index {
    color: rgba(61, 187, 200, 0.22);
  }

  .ben__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 0.4rem;
    border-radius: 12px;
    background: linear-gradient(150deg, rgba(41, 226, 249, 0.16), rgba(61, 187, 200, 0.08));
    border: 1px solid rgba(61, 187, 200, 0.3);
    color: var(--navy-800);
  }

  .ben__title {
    font-size: var(--step-1);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.05;
    max-width: 14ch;
  }

  .ben__desc {
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--ink-500);
    max-width: 34ch;
  }

  @media (min-width: 640px) {
    .ben__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .ben__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
