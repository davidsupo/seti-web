---
import type { CollectionEntry } from 'astro:content';
import BlogCover from './BlogCover.astro';
import Icon from './ui/Icon.astro';
import { formatDate, readingTime } from '../lib/format';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, tags, cover, coverAlt, icon, author } = post.data;
const href = `/blog/${post.id}/`;
const minutes = readingTime(post.body);
---

<article class:list={['blog-card', featured && 'blog-card--featured']}>
  <a href={href} class="blog-card__media" tabindex="-1" aria-hidden="true">
    {
      cover ? (
        <img src={cover} alt={coverAlt ?? ''} width="800" height="450" loading="lazy" decoding="async" />
      ) : (
        <BlogCover icon={icon} />
      )
    }
    {tags[0] && <span class="blog-card__tag">{tags[0]}</span>}
  </a>

  <div class="blog-card__body">
    <p class="blog-card__meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} min de lectura</span>
    </p>

    <h3 class="blog-card__title">
      <a href={href}>{title}</a>
    </h3>

    <p class="blog-card__desc">{description}</p>

    <div class="blog-card__footer">
      <span class="blog-card__author">
        <span class="blog-card__avatar" aria-hidden="true">
          <Icon name="sparkles" size={13} />
        </span>
        {author}
      </span>
      <span class="blog-card__more">
        Leer
        <Icon name="arrow-right" size={14} stroke={2} />
      </span>
    </div>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface-0);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    border-color: rgba(61, 187, 200, 0.5);
    box-shadow: var(--shadow-md);
  }

  .blog-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--navy-900);
  }

  .blog-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  .blog-card:hover .blog-card__media img {
    transform: scale(1.04);
  }

  .blog-card__tag {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 2;
    padding: 0.3rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy-950);
    background: var(--cyan-300);
    border-radius: 3px;
  }

  .blog-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
    padding: 1.4rem;
  }

  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-500);
  }

  .blog-card__title {
    position: relative;
    font-size: var(--step-1);
    line-height: 1.12;
    letter-spacing: 0.005em;
  }

  .blog-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  .blog-card__desc {
    font-size: 0.86rem;
    line-height: 1.65;
    color: var(--ink-500);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .blog-card__author {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.68rem;
    color: var(--ink-500);
    min-width: 0;
  }

  .blog-card__avatar {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--blue-500);
  }

  .blog-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue-500);
  }

  .blog-card:hover .blog-card__more {
    color: var(--teal-400);
  }

  .blog-card--featured .blog-card__title {
    font-size: var(--step-2);
  }
</style>
