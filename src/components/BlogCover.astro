---
import Icon from './ui/Icon.astro';

interface Props {
  icon?: string;
  /** Texto pequeño sobre la portada */
  label?: string;
  class?: string;
}

const { icon = 'sparkles', label = 'SETI Insights', class: className } = Astro.props;
---

<div class:list={['bcover', className]} aria-hidden="true">
  <div class="bcover__mesh"></div>
  <div class="bcover__glow"></div>
  <span class="bcover__label">{label}</span>
  <span class="bcover__icon"><Icon name={icon as any} size={46} stroke={1.2} /></span>
  <span class="bcover__ring"></span>
</div>

<style>
  .bcover {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    min-height: 190px;
    overflow: hidden;
    background:
      radial-gradient(120% 120% at 85% 15%, rgba(41, 226, 249, 0.22) 0%, transparent 55%),
      linear-gradient(145deg, #0d3452 0%, #072338 55%, #04141f 100%);
  }

  .bcover__mesh {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: radial-gradient(ellipse at 50% 50%, #000 10%, transparent 78%);
  }

  .bcover__glow {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(41, 226, 249, 0.28) 0%, transparent 70%);
    filter: blur(10px);
  }

  .bcover__label {
    position: absolute;
    top: 0.9rem;
    left: 1rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .bcover__icon {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 92px;
    height: 92px;
    border-radius: 20px;
    color: var(--cyan-300);
    background: rgba(4, 20, 31, 0.55);
    border: 1px solid rgba(41, 226, 249, 0.35);
    box-shadow:
      0 0 0 8px rgba(41, 226, 249, 0.05),
      0 24px 48px -24px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(6px);
    transition: transform 600ms var(--ease-out);
  }

  .bcover__ring {
    position: absolute;
    width: 210px;
    height: 210px;
    border-radius: 50%;
    border: 1px dashed rgba(41, 226, 249, 0.22);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.blog-card:hover) .bcover__icon {
      transform: scale(1.06) rotate(-3deg);
    }
  }
</style>
