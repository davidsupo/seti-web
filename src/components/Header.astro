---
import { nav, site, whatsappLink } from '../data/site';
import Icon from './ui/Icon.astro';
import Logo from './ui/Logo.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href.replace(/\/$/, ''));
const phoneDigits = site.phone.label.replace(/\s+/g, '');
---

<header class="header" id="site-header">
  <div class="header__bar container--wide">
    <Logo variant="light" height={36} />

    <nav class="nav" aria-label="Navegación principal">
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li class:list={['nav__item', item.children && 'nav__item--has-menu']}>
              <a
                href={item.href}
                class:list={['nav__link', isActive(item.href) && 'is-active']}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
                {item.children && <Icon name="chevron-down" size={13} stroke={2} class="nav__chevron" />}
              </a>
              {item.children && (
                <div class="nav__menu">
                  <p class="nav__menu-title">Servicios</p>
                  <ul class="nav__menu-list">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class="nav__menu-link">
                          <span class="nav__menu-label">{child.label}</span>
                          <span class="nav__menu-desc">{child.description}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a href={site.phone.href} class="header__phone">
        <Icon name="phone" size={16} />
        <span>{site.phone.label}</span>
      </a>
      <a href="/contacto/" class="btn-quote">Cotizar proyecto</a>
      <button class="burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div class="mobile" id="mobile-menu" hidden>
    <div class="mobile__inner">
      <ul class="mobile__list">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['mobile__link', isActive(item.href) && 'is-active']}
                data-close-menu
              >
                {item.label}
                <Icon name="arrow-up-right" size={16} />
              </a>
              {item.children && (
                <ul class="mobile__sublist">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} data-close-menu>{child.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mobile__footer">
        <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="mobile__contact">
          <Icon name="whatsapp" size={18} />
          Escribir por WhatsApp
        </a>
        <a href={site.phone.href} class="mobile__contact">
          <Icon name="phone" size={18} />
          {site.phone.label}
        </a>
        <a href={site.email.href} class="mobile__contact mobile__contact--mail">
          <Icon name="mail" size={18} />
          {site.email.label.toLowerCase()}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const burger = header?.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('mobile-menu');

  const setScrolled = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 12);
  };
  setScrolled();
  window.addEventListener('scroll', setScrolled, { passive: true });

  const closeMenu = () => {
    if (!menu || !burger) return;
    menu.hidden = true;
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', 'Abrir menú');
    document.body.classList.remove('menu-open');
    header?.classList.remove('is-open');
  };

  const openMenu = () => {
    if (!menu || !burger) return;
    menu.hidden = false;
    burger.setAttribute('aria-expanded', 'true');
    burger.setAttribute('aria-label', 'Cerrar menú');
    document.body.classList.add('menu-open');
    header?.classList.add('is-open');
  };

  burger?.addEventListener('click', () => {
    if (burger.getAttribute('aria-expanded') === 'true') closeMenu();
    else openMenu();
  });

  menu?.querySelectorAll('[data-close-menu], a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 1024) closeMenu();
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(7, 27, 45, 0.94);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(14px) saturate(140%);
    transition:
      background var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .header.is-scrolled,
  .header.is-open {
    background: rgba(4, 20, 31, 0.98);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 18px 40px -30px rgba(0, 0, 0, 0.9);
  }

  .header__bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ---------- Navegación escritorio ---------- */
  .nav {
    display: none;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.8rem;
    font-size: 0.86rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.78);
    border-radius: var(--radius-sm);
    transition: color var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }

  .nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.15rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--cyan-300), var(--teal-400));
  }

  .nav__chevron {
    opacity: 0.6;
    transition: transform var(--dur) var(--ease-out);
  }

  .nav__item--has-menu:hover .nav__chevron,
  .nav__item--has-menu:focus-within .nav__chevron {
    transform: rotate(180deg);
  }

  .nav__menu {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 50%;
    translate: -50% 0;
    width: min(360px, 88vw);
    padding: 0.75rem;
    background: rgba(9, 32, 54, 0.98);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      visibility var(--dur);
  }

  .nav__item--has-menu:hover .nav__menu,
  .nav__item--has-menu:focus-within .nav__menu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .nav__menu-title {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cyan-300);
    padding: 0.4rem 0.6rem 0.6rem;
  }

  .nav__menu-list {
    display: grid;
    gap: 0.15rem;
  }

  .nav__menu-link {
    display: grid;
    gap: 0.1rem;
    padding: 0.65rem 0.6rem;
    border-radius: var(--radius-sm);
    transition: background var(--dur) var(--ease-out);
  }

  .nav__menu-link:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  .nav__menu-label {
    font-size: 0.86rem;
    font-weight: 600;
    color: #fff;
  }

  .nav__menu-desc {
    font-size: 0.74rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.5);
  }

  /* ---------- Acciones ---------- */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .header__phone {
    display: none;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.75);
    transition: color var(--dur) var(--ease-out);
  }

  .header__phone:hover {
    color: var(--cyan-300);
  }

  .btn-quote {
    display: none;
    align-items: center;
    padding: 0.62rem 1.15rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--navy-950);
    background: linear-gradient(100deg, var(--cyan-300), var(--teal-400));
    border-radius: var(--radius-pill);
    transition: box-shadow var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }

  .btn-quote:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 28px -14px rgba(41, 226, 249, 0.9);
  }

  .burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 10px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.16);
  }

  .burger span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: #fff;
    border-radius: 2px;
    transition: transform var(--dur) var(--ease-out), opacity var(--dur) var(--ease-out);
  }

  .burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ---------- Menú móvil ---------- */
  .mobile {
    position: fixed;
    inset: var(--header-h) 0 0;
    background: linear-gradient(180deg, #071b2d 0%, #04141f 100%);
    overflow-y: auto;
    padding: 2rem var(--gutter) 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    animation: menu-in 260ms var(--ease-out);
  }

  .mobile[hidden] {
    display: none;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .mobile__inner {
    display: grid;
    gap: 2.5rem;
    max-width: 560px;
    margin-inline: auto;
  }

  .mobile__list {
    display: grid;
    gap: 0.15rem;
  }

  .mobile__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
    text-transform: uppercase;
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile__link.is-active {
    color: var(--cyan-300);
  }

  .mobile__sublist {
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 0 1rem 1rem;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    margin-left: 0.2rem;
  }

  .mobile__sublist a {
    display: block;
    padding: 0.45rem 0;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.62);
  }

  .mobile__footer {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mobile__contact {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--on-dark-muted);
  }

  .mobile__contact svg {
    color: var(--cyan-300);
  }

  .mobile__contact--mail {
    word-break: break-all;
    font-size: 0.8rem;
  }

  /* ---------- Breakpoints ---------- */
  @media (min-width: 640px) {
    .header__phone {
      display: inline-flex;
    }
  }

  @media (min-width: 1024px) {
    .nav {
      display: block;
    }

    .btn-quote {
      display: inline-flex;
    }

    .burger {
      display: none;
    }

    .mobile {
      display: none !important;
    }
  }

  @media (min-width: 1200px) {
    .nav__link {
      padding-inline: 0.95rem;
    }
  }
</style>
