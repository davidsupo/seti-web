---
import Icon from './ui/Icon.astro';
import { withBase } from '../lib/base';
import type { Service } from '../data/services';

interface Props {
  service: Service;
  compact?: boolean;
}

const { service, compact = false } = Astro.props;
const href = withBase(`/servicios/${service.slug}/`);
---

<article class:list={['svc', compact && 'svc--compact']}>
  <div class="svc__head">
    <span class="svc__icon"><Icon name={service.icon as any} size={22} /></span>
    <span class="svc__num">{service.order}</span>
  </div>

  <h3 class="svc__title">
    <a href={href}>{service.title}</a>
  </h3>
  <p class="svc__tagline">{service.tagline}</p>
  <p class="svc__summary">{service.summary}</p>

  {!compact && (
    <ul class="svc__tags">
      {service.capabilities.slice(0, 3).map((capability) => (
        <li>{capability}</li>
      ))}
    </ul>
  )}

  <span class="svc__link">
    Ver servicio
    <Icon name="arrow-right" size={14} stroke={2} />
  </span>
</article>

<style>
  .svc {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    height: 100%;
    padding: clamp(1.4rem, 2.4vw, 1.9rem);
    background: var(--surface-0);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      border-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .svc::before {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--cyan-300), var(--teal-400));
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }

  .svc:hover {
    border-color: rgba(61, 187, 200, 0.55);
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .svc:hover::before {
    opacity: 1;
  }

  .svc__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }

  .svc__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--surface-1);
    border: 1px solid var(--line);
    color: var(--navy-800);
    transition:
      background var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .svc:hover .svc__icon {
    background: var(--navy-800);
    border-color: var(--navy-800);
    color: var(--cyan-300);
  }

  .svc__num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--ink-300);
  }

  .svc__title {
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .svc__title a {
    display: inline-block;
  }

  .svc__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .svc__tagline {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal-400);
  }

  .svc__summary {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--ink-500);
  }

  .svc__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.35rem;
  }

  .svc__tags li {
    padding: 0.25rem 0.55rem;
    font-size: 0.68rem;
    color: var(--ink-700);
    background: var(--surface-1);
    border-radius: var(--radius-xs);
  }

  .svc__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue-500);
    transition: gap var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }

  .svc:hover .svc__link {
    gap: 0.7rem;
    color: var(--teal-400);
  }

  .svc--compact .svc__summary {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
