---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Ticker from '../components/sections/Ticker.astro';
import About from '../components/sections/About.astro';
import Services from '../components/sections/Services.astro';
import Process from '../components/sections/Process.astro';
import Coverage from '../components/sections/Coverage.astro';
import Benefits from '../components/sections/Benefits.astro';
import Projects from '../components/sections/Projects.astro';
import BlogPreview from '../components/sections/BlogPreview.astro';
import Faq from '../components/sections/Faq.astro';
import Cta from '../components/sections/Cta.astro';
import { faqs } from '../data/faqs';
import { organizationSchema, localBusinessSchema, websiteSchema, faqSchema } from '../lib/schema';

const jsonLd = [organizationSchema, localBusinessSchema, websiteSchema, faqSchema(faqs)];
---

<BaseLayout
  title="Inicio"
  description="SETI Technology: soluciones integrales de seguridad electrónica en Perú. Alarmas de intrusión, detección de incendio, videovigilancia, control de acceso y redes."
  jsonLd={jsonLd}
>
  <Hero />
  <Ticker />
  <About />
  <Services />
  <Process />
  <Coverage />
  <Benefits />
  <Projects />
  <BlogPreview />
  <Faq />
  <Cta />
</BaseLayout>
